{
  "name": "@jared/workspace",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@jared/server",
    "build": "turbo build",
    "deploy": "turbo deploy --filter=@jared/server",
    "format": "biome check --write .",
    "prepare": "is-ci || husky"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@modelcontextprotocol/sdk>@hono/node-server": "1.19.15",
      "browserslist": "4.28.7",
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.6",
      "ip-address": "10.3.1",
      "js-yaml@^4.0.0": "4.3.1",
      "next": "16.2.11",
      "postcss": "8.5.25",
      "postcss-selector-parser": "7.1.3",
      "qs": "6.16.0",
      "sharp": ">=0.35.0",
      "tsx>esbuild": "0.28.1",
      "undici": ">=7.29.0"
    },
    "patchedDependencies": {
      "@flue/runtime@2.0.1": "patches/@flue__runtime@2.0.1.patch"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "nano-staged": "^1.0.2",
    "turbo": "^2.9.14",
    "typescript": "^5.9.2"
  }
