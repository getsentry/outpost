{
  "name": "@jared/workspace",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@jared/server",
    "build": "turbo build",
    "deploy": "turbo deploy --filter=@jared/server",
    "format": "biome check --write .",
    "prepare": "is-ci || husky"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "undici": ">=7.28.0",
      "next": "16.2.11",
      "js-yaml@^4.0.0": "4.3.0",
      "sharp": ">=0.35.0"
    },
    "patchedDependencies": {
      "@flue/runtime@2.0.1": "patches/@flue__runtime@2.0.1.patch"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "nano-staged": "^1.0.2",
    "turbo": "^2.9.14",
    "typescript": "^5.9.2"
  }
}
