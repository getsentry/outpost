{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jared",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jared",
      "database_id": "d52c2301-5a23-4bb1-a15b-225725900001"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./container/Dockerfile",
      "max_instances": 10,
      "instance_type": "standard-3",
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "aditya",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEOr1/J9gXKCeqijk8guM5K0GoAfbRmq3xm4vtKlEB/c"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["OpenCodeContainer"],
      "tag": "v1"
    },
    {
      "renamed_classes": [{ "from": "OpenCodeContainer", "to": "Sandbox" }],
      "tag": "v2"
    },
    {
      // Flue-generated Jared agent Durable Object (Phase 2).
      // Class name follows Flue convention: Flue + AgentName + Agent.
      "new_sqlite_classes": ["FlueJaredAgent"],
      "tag": "v3-flue-jared"
    }
  ],
  "triggers": {
    // Optional application-wide cron (UTC). Per-conversation schedules use DO schedule().
    "crons": ["0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1465",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/health", "/openapi.json"]
  },
  "vars": {
    // Flip to "1" to run the agent brain as a Flue Durable Object (Phase 2).
    // Leave unset/"0" for Phase 1 in-container Flue.
    "FLUE_NATIVE": "1"
  }
}
