{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jared",
  // Leave `main` unset so Flue's vite plugin can set it to `virtual:flue/worker`
  // (generated entry that registers agents + exports FlueJaredAgent + Sandbox).
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jared",
      "database_id": "d52c2301-5a23-4bb1-a15b-225725900001"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      // Phase 1 default (FLUE_NATIVE=0): in-container Flue + Lore.
      // Flip image to "./container/Dockerfile" when setting FLUE_NATIVE=1.
      "image": "./container/Dockerfile.phase1",
      "max_instances": 10,
      "instance_type": "standard-3",
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "aditya",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEOr1/J9gXKCeqijk8guM5K0GoAfbRmq3xm4vtKlEB/c"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["OpenCodeContainer"],
      "tag": "v1"
    },
    {
      "renamed_classes": [{ "from": "OpenCodeContainer", "to": "Sandbox" }],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["FlueJaredAgent"],
      "tag": "v3-flue-jared"
    }
  ],
  "triggers": {
    // Daily at 03:17 UTC: delete webhook_events older than 24 hours.
    // Agent follow-ups remain per-conversation via DO scheduleFollowUp().
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1465",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/health", "/openapi.json"]
  },
  "vars": {
    // Keep Phase 1 (in-container Flue) as the safe default until Phase 2 is
    // validated in a real Cloudflare deploy. Flip to "1" for DO-native.
    "FLUE_NATIVE": "0"
  }
}
