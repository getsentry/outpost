ENV="development"

BETTER_AUTH_SECRET=
APP_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=
# Deployment metadata and sampling. Staging defaults to 1.0 and production to
# 0.1 when SENTRY_TRACES_SAMPLE_RATE is unset; errors and terminal failures are
# always reported. Keep AI input/output recording disabled unless explicitly
# approved for the target Sentry project.
SENTRY_ENVIRONMENT=development
# Explicit release shared by the Worker runtime and build-only source-map upload.
# Required when SENTRY_AUTH_TOKEN is configured for source maps.
# SENTRY_RELEASE=outpost@<commit>
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_AI_RECORD_INPUTS=false
# SENTRY_AI_RECORD_OUTPUTS=false

# Frontend Sentry (separate project from server)
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# Optional public override; otherwise the Sentry Vite plugin embeds SENTRY_RELEASE.
# VITE_SENTRY_RELEASE=outpost@<commit>
# VITE_SENTRY_TRACES_SAMPLE_RATE=
# Absolute browser-to-Worker API origin. Propagation is disabled when unset.
# VITE_JARED_API_ORIGIN=http://localhost:5173

# Build runner only — do not put these in Worker secrets or VITE_* variables.
# The build uploads separate source maps to the matching project and deletes
# local maps after a successful upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_SERVER_PROJECT=jared-server
# SENTRY_WEB_PROJECT=jared-web

# GitHub App (for webhook handling)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# For running drizzle studio for prod
CLOUDFLARE_ACCOUNT_ID=
DATABASE=
CLOUDFLARE_D1_API_TOKEN=

# Agent API keys - For Local testing
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Flue harness
# FLUE_NATIVE=0 (default): Phase 1 in-container Flue (safer until Phase 2 is validated).
# FLUE_NATIVE=1: agent brain runs as a Flue Durable Object; container is a thin sandbox.
# IMPORTANT: FLUE_NATIVE and containers[].image must move together:
#   0 → Dockerfile.phase1
#   1 → Dockerfile
FLUE_NATIVE=0
# Standalone Lore gateway (Phase 2). See docs/LORE_GATEWAY.md
LORE_GATEWAY_URL=
# Shared secret for Worker↔Flue history pulls and for minting per-entity
# session-ingest tokens (the raw secret is NEVER written into sandboxes).
# Prefer setting this explicitly. If unset, a purpose-bound HMAC of
# BETTER_AUTH_SECRET is derived.
FLUE_INTERNAL_TOKEN=

# Sentry internal integration (for assigning Sentry issues to the agent)
# SENTRY_INTEGRATION_CLIENT_SECRET=
# SENTRY_INTEGRATION_TOKEN=
