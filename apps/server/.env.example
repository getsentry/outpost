ENV="development"

BETTER_AUTH_SECRET=
APP_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=

# Frontend Sentry (separate project from server)
VITE_SENTRY_DSN=

# GitHub App (for webhook handling)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# For running drizzle studio for prod
CLOUDFLARE_ACCOUNT_ID=
DATABASE=
CLOUDFLARE_D1_API_TOKEN=

# Agent API keys - For Local testing
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Flue harness (Phase 2)
# FLUE_NATIVE=1 runs the agent brain as a Durable Object (default in wrangler vars).
# FLUE_NATIVE=0 keeps Phase 1 in-container Flue (requires Dockerfile.phase1 image).
FLUE_NATIVE=1
# Standalone Lore gateway (Phase 2). See docs/LORE_GATEWAY.md
LORE_GATEWAY_URL=

# Sentry internal integration (for assigning Sentry issues to the agent)
# SENTRY_INTEGRATION_CLIENT_SECRET=
# SENTRY_INTEGRATION_TOKEN=
