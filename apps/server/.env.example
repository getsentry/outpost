ENV="development"

BETTER_AUTH_SECRET=
APP_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=

# Frontend Sentry (separate project from server)
VITE_SENTRY_DSN=

# GitHub App (for webhook handling)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# For running drizzle studio for prod
CLOUDFLARE_ACCOUNT_ID=
DATABASE=
CLOUDFLARE_D1_API_TOKEN=

# Agent API keys - For Local testing
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Flue harness
# FLUE_NATIVE=0 (default): Phase 1 in-container Flue (safer until Phase 2 is validated).
# FLUE_NATIVE=1: agent brain runs as a Flue Durable Object; container is a thin sandbox.
FLUE_NATIVE=0
# Standalone Lore gateway (Phase 2). See docs/LORE_GATEWAY.md
LORE_GATEWAY_URL=

# Sentry internal integration (for assigning Sentry issues to the agent)
# SENTRY_INTEGRATION_CLIENT_SECRET=
# SENTRY_INTEGRATION_TOKEN=
