# Phase 1: Flue Node server + Lore gateway inside the Cloudflare Sandbox.
# This is the PRODUCTION DEFAULT while Phase 2 is validated
# (wrangler: FLUE_NATIVE=0 + image Dockerfile.phase1).
#
# linux/amd64 only (Cloudflare Containers requirement).
#
# IMPORTANT: this tag MUST match the @cloudflare/sandbox SDK version the Worker
# runs (see apps/server/package.json). The SDK client and the in-container
# control server share a protocol; a mismatch makes every sandbox.exec() hang,
# so dispatch stalls the moment it touches the container and nothing ever runs.

FROM docker.io/cloudflare/sandbox:0.12.0

RUN apt-get update \
 && install -d -m 0755 /etc/apt/keyrings \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      fd-find fzf gh git jq ripgrep \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

# Keep pnpm pinned to the repo's packageManager version. pnpm 11 makes ignored
# dependency build scripts a hard install error, so `pnpm@latest` breaks the
# image build whenever upstream ships a new major.
ENV N_PREFIX=/usr/local
RUN npm install -g n \
 && n 22 \
 && hash -r \
 && corepack enable \
 && corepack prepare pnpm@10.15.0 --activate

# Do NOT pre-create /workspace/repo — the Worker clones into a temp dir and
# `mv`s it to /workspace/repo; an existing empty dest would nest the clone.
RUN mkdir -p /workspace /opt/flue /root/.agents

COPY flue/package.json /opt/flue/package.json
WORKDIR /opt/flue
RUN pnpm install --prod=false
COPY flue/ /opt/flue/
# Build Flue app. Skills stay under /opt/flue and /root/.agents — NEVER under
# /workspace/repo (Worker git-clones into that path).
RUN pnpm build

# Lore is optional at image-build time: install failures are recorded and the
# runtime health probe in ensureSandboxReady decides whether to route traffic.
RUN curl -fsSL https://withlore.ai/install | bash \
 || echo "WARNING: lore install failed — Phase 1 will run without Lore gateway" >&2

COPY .agents/skills/ /root/.agents/skills/
COPY AGENTS.md /root/AGENTS.md
# Also keep a copy next to the Flue app for ensureWorkspaceSkills().
RUN mkdir -p /opt/flue/.agents && cp -R /root/.agents/skills /opt/flue/.agents/skills \
 && cp /root/AGENTS.md /opt/flue/AGENTS.md

# Do NOT set ENV PORT here. The base image ENTRYPOINT (/container-server/sandbox)
# is the sandbox control server the Worker's SDK talks to on port 3000; it reads
# $PORT to choose its listen port, so setting PORT=4096 makes it bind the wrong
# port and the SDK never sees the container become ready — every exec fails with
# "Container is starting. Please retry in a moment." forever. Flue's port is set
# by the bootstrap subshell (export PORT=$FLUE_PORT) at runtime instead.
ENV FLUE_PORT=4096
ENV LORE_GATEWAY_URL=http://127.0.0.1:3207
EXPOSE 4096
# Keep the base image's working dir so the control server resolves its bundled
# executors. The Worker always passes an explicit cwd to exec()/startProcess().
WORKDIR /container-server
